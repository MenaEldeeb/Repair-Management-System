
@model IEnumerable<FinalProject.Models.RepairOrder>

@{
    ViewData["Title"] = "Repair Orders";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>
            <div class="page-icon mb-3">
                <i class="bi bi-tools"></i>
            </div>

            <h2 class="fw-bold mb-1">
                Repair Orders
            </h2>

            <p class="text-muted mb-0">
                Manage repair orders and service information.
            </p>
        </div>

        <div>
            <a asp-action="Create" class="btn btn-primary px-4">
                <i class="bi bi-plus-lg me-2"></i>
                Add Repair Order
            </a>
        </div>

    </div>


    <!-- TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th class="px-4">
                                        ID
                                    </th>

                                    <th>
                                        Customer
                                    </th>

                                    <th>
                                        Device
                                    </th>

                                    <th>
                                        Technician
                                    </th>

                                    <th>
                                        Receive Date
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Cost
                                    </th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <!-- ID -->
                                            <td class="px-4">

                                                <span class="badge bg-light text-dark border">
                                                    #@item.RepairOrderId
                                                </span>

                                            </td>


                                            <!-- CUSTOMER -->
                                            <td>

                                        @if (item.Device?.Customer != null)
                                        {
                                                        <div>
                                                            <div class="fw-semibold">
                                                    @item.Device.Customer.Fname
                                                    @item.Device.Customer.Lname
                                                            </div>

                                                            <small class="text-muted">
                                                                <i class="bi bi-telephone me-1"></i>
                                                    @item.Device.Customer.Phone
                                                            </small>
                                                        </div>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Customer
                                                        </span>
                                        }

                                            </td>


                                            <!-- DEVICE -->
                                            <td>

                                        @if (item.Device != null)
                                        {
                                                        <div>

                                                            <div class="fw-semibold">
                                                    @item.Device.DeviceName
                                                            </div>

                                                            <small class="text-muted">
                                                                <i class="bi bi-laptop me-1"></i>
                                                    @item.Device.DeviceType
                                                            </small>

                                                        </div>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Device
                                                        </span>
                                        }

                                            </td>


                                            <!-- TECHNICIAN -->
                                            <td>

                                        @if (item.Technician != null)
                                        {
                                                        <span class="fw-semibold">
                                                @item.Technician.Name
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Technician
                                                        </span>
                                        }

                                            </td>


                                            <!-- RECEIVE DATE -->
                                            <td>

                                                <div class="text-nowrap">

                                                    <i class="bi bi-calendar3 me-1 text-muted"></i>

                                            @item.ReceiveDate.ToString("dd/MM/yyyy")

                                                </div>

                                            </td>


                                            <!-- STATUS -->
                                            <td>

                                        @if (item.Status == "Pending")
                                        {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="bi bi-clock me-1"></i>
                                                            Pending
                                                        </span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                                        <span class="badge bg-info text-dark">
                                                            <i class="bi bi-wrench me-1"></i>
                                                            In Progress
                                                        </span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-check-circle me-1"></i>
                                                            Completed
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="badge bg-secondary">
                                                @item.Status
                                                        </span>
                                        }

                                            </td>


                                            <!-- COST -->
                                            <td>

                                                <span class="fw-semibold text-nowrap">
                                            @item.Cost.ToString("0.00") EGP
                                                </span>

                                            </td>


                                            <!-- ACTIONS -->
                                            <td>

                                                <div class="d-flex justify-content-center gap-1 flex-wrap">

                                                    <a asp-action="Details"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-info btn-sm">

                                                        <i class="bi bi-eye"></i>

                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-warning btn-sm">

                                                        <i class="bi bi-pencil"></i>

                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-danger btn-sm">

                                                        <i class="bi bi-trash"></i>

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }
            else
            {
                    <!-- EMPTY STATE -->

                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">
                            <i class="bi bi-tools"></i>
                        </div>

                        <h4 class="fw-bold">
                            No Repair Orders Found
                        </h4>

                        <p class="text-muted">
                            You haven't added any repair orders yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-primary px-4">

                            <i class="bi bi-plus-lg me-2"></i>
                            Add Your First Repair Order

                        </a>

                    </div>
            }

        </div>

    </div>

</div>

