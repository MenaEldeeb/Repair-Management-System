@model IEnumerable<FinalProject.Models.RepairOrder>

@{
    ViewData["Title"] = "Repair Orders";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div class="text-center text-md-start">

            <div class="page-icon mb-3">
                <i class="bi bi-tools"></i>
            </div>

            <h2 class="fw-bold mb-1">
                Repair Orders
            </h2>

            <p class="text-muted mb-0">
                Manage repair orders and service information.
            </p>

        </div>

        <div class="text-center">

            <a asp-action="Create"
               class="btn btn-primary px-4">

                <i class="bi bi-plus-lg me-2"></i>
                Add Repair Order

            </a>

        </div>

    </div>


    <!-- Repair Orders Table -->

    <div class="card form-card border-0">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>

                                    <th>ID</th>

                                    <th>Device</th>

                                    <th>Technician</th>

                                    <th>Receive Date</th>

                                    <th>Status</th>

                                    <th>Cost</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <td>
                                                <span class="customer-id">
                                                    #@item.RepairOrderId
                                                </span>
                                            </td>


                                            <td>

                                        @if (item.Device != null)
                                        {
                                                        <span class="fw-semibold">
                                                @item.Device.DeviceName
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Device
                                                        </span>
                                        }

                                            </td>


                                            <td>

                                        @if (item.Technician != null)
                                        {
                                                        <span class="fw-semibold">
                                                @item.Technician.Name
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Technician
                                                        </span>
                                        }

                                            </td>


                                            <td>

                                                <i class="bi bi-calendar3 me-1 text-muted"></i>

                                        @item.ReceiveDate.ToString("dd/MM/yyyy")

                                            </td>


                                            <td>

                                        @if (item.Status == "Pending")
                                        {
                                                        <span class="badge bg-warning text-dark">
                                                            Pending
                                                        </span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                                        <span class="badge bg-info text-dark">
                                                            In Progress
                                                        </span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                                        <span class="badge bg-success">
                                                            Completed
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="badge bg-secondary">
                                                @item.Status
                                                        </span>
                                        }

                                            </td>


                                            <td>

                                                <span class="fw-semibold">
                                            @item.Cost.ToString("0.00")
                                                </span>

                                            </td>


                                            <td>

                                                <div class="d-flex justify-content-center gap-2">

                                                    <a asp-action="Details"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-info action-btn">

                                                        <i class="bi bi-eye me-1"></i>
                                                        Details

                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-warning action-btn">

                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Edit

                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.RepairOrderId"
                                                       class="btn btn-danger action-btn">

                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }
            else
            {
                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">
                            <i class="bi bi-tools"></i>
                        </div>

                        <h4 class="fw-bold">
                            No Repair Orders Found
                        </h4>

                        <p class="text-muted">
                            You haven't added any repair orders yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-primary px-4">

                            <i class="bi bi-plus-lg me-2"></i>
                            Add Your First Repair Order

                        </a>

                    </div>
            }

        </div>

    </div>

</div>