@model FinalProject.Models.RepairOrder

@{
    ViewData["Title"] = "Delete Repair Order";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-4">

        <div class="page-icon mx-auto mb-3">
            <i class="bi bi-trash"></i>
        </div>

        <h2 class="fw-bold mb-1">
            Delete Repair Order
        </h2>

        <p class="text-muted mb-0">
            Remove this repair order from the system.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card form-card border-0">

                <div class="card-body p-4 p-md-5">

                    <!-- Warning -->

                    <div class="alert alert-danger d-flex align-items-center mb-4">

                        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>

                        <div>
                            <strong>Are you sure?</strong>
                            <br />
                            This repair order will be permanently deleted.
                        </div>

                    </div>


                    <!-- Order Information -->

                    <div class="section-title mb-4">

                        <div class="section-number">
                            01
                        </div>

                        <div>
                            <h5 class="mb-0">
                                Repair Order Information
                            </h5>

                            <small class="text-muted">
                                Information about the order you are deleting
                            </small>
                        </div>

                    </div>


                    <div class="row g-4 mb-4">

                        <!-- Order ID -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    Repair Order ID
                                </small>

                                <span class="fw-semibold">
                                    #@Model.RepairOrderId
                                </span>

                            </div>

                        </div>


                        <!-- Device -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    <i class="bi bi-laptop me-1"></i>
                                    Device
                                </small>

                                @if (Model.Device != null)
                                {
                                        <span class="fw-semibold">
                                        @Model.Device.DeviceName
                                        </span>
                                }
                                else
                                {
                                        <span class="text-muted">
                                            No Device
                                        </span>
                                }

                            </div>

                        </div>


                        <!-- Technician -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    <i class="bi bi-person-gear me-1"></i>
                                    Technician
                                </small>

                                @if (Model.Technician != null)
                                {
                                        <span class="fw-semibold">
                                        @Model.Technician.Name
                                        </span>
                                }
                                else
                                {
                                        <span class="text-muted">
                                            No Technician
                                        </span>
                                }

                            </div>

                        </div>


                        <!-- Status -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    Status
                                </small>

                                @if (Model.Status == "Pending")
                                {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                }
                                else if (Model.Status == "In Progress")
                                {
                                        <span class="badge bg-info text-dark">
                                            In Progress
                                        </span>
                                }
                                else if (Model.Status == "Completed")
                                {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                }
                                else
                                {
                                        <span class="badge bg-secondary">
                                        @Model.Status
                                        </span>
                                }

                            </div>

                        </div>


                        <!-- Cost -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    <i class="bi bi-currency-dollar me-1"></i>
                                    Cost
                                </small>

                                <span class="fw-semibold">
                                    @Model.Cost.ToString("0.00")
                                </span>

                            </div>

                        </div>


                        <!-- Receive Date -->

                        <div class="col-md-6">

                            <div class="p-3 border rounded">

                                <small class="text-muted d-block mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>
                                    Receive Date
                                </small>

                                <span class="fw-semibold">
                                    @Model.ReceiveDate.ToString("dd/MM/yyyy")
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- Description -->

                    <div class="mb-4">

                        <small class="text-muted d-block mb-2">
                            Description
                        </small>

                        <div class="p-3 border rounded">

                            @if (!string.IsNullOrWhiteSpace(Model.Description))
                            {
                                    <span>
                                    @Model.Description
                                    </span>
                            }
                            else
                            {
                                    <span class="text-muted">
                                        No description provided.
                                    </span>
                            }

                        </div>

                    </div>


                    <!-- Buttons -->

                    <form asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.RepairOrderId" />

                        @Html.AntiForgeryToken()

                        <div class="d-flex flex-column flex-sm-row
                                    justify-content-between
                                    gap-3 mt-4 pt-4 border-top">

                            <a asp-action="Index"
                               class="btn btn-light px-4">

                                <i class="bi bi-arrow-left me-2"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Delete Repair Order

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
