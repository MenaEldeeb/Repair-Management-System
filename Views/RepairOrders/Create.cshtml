@model FinalProject.Models.RepairOrder

@{
    ViewData["Title"] = "Add Repair Order";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="text-center mb-4">

        <div class="page-icon mx-auto mb-3">
            <i class="bi bi-tools"></i>
        </div>

        <h2 class="fw-bold mb-1">
            Add New Repair Order
        </h2>

        <p class="text-muted mb-0">
            Create a new repair order for a customer device.
        </p>

    </div>


    <div class="row justify-content-center">

        <div class="col-xl-8 col-lg-9">

            <div class="card form-card border-0">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <!-- Repair Information -->

                        <div class="section-title mb-4">

                            <div class="section-number">
                                01
                            </div>

                            <div>
                                <h5 class="mb-0">
                                    Repair Information
                                </h5>

                                <small class="text-muted">
                                    Select the device and technician
                                </small>
                            </div>

                        </div>


                        <div class="row">

                            <!-- Device -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="DeviceId"
                                       class="form-label fw-semibold">

                                    Device

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-laptop"></i>
                                    </span>

                                    <select asp-for="DeviceId"
                                            class="form-select"
                                            asp-items="@(new SelectList(ViewBag.Devices, "DeviceId", "DeviceName"))">

                                        <option value="">
                                            -- Select Device --
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="DeviceId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Technician -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="TechnicianId"
                                       class="form-label fw-semibold">

                                    Technician

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-person-gear"></i>
                                    </span>

                                    <select asp-for="TechnicianId"
                                            class="form-select"
                                            asp-items="@(new SelectList(ViewBag.Technicians, "TechnicianId", "Name"))">

                                        <option value="">
                                            -- Select Technician --
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="TechnicianId"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Dates -->

                        <div class="section-title mb-4 mt-2">

                            <div class="section-number">
                                02
                            </div>

                            <div>
                                <h5 class="mb-0">
                                    Repair Dates
                                </h5>

                                <small class="text-muted">
                                    Enter the repair schedule
                                </small>
                            </div>

                        </div>


                        <div class="row">

                            <!-- Receive Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="ReceiveDate"
                                       class="form-label fw-semibold">

                                    Receive Date

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-calendar3"></i>
                                    </span>

                                    <input asp-for="ReceiveDate"
                                           type="date"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="ReceiveDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Delivery Date -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="DeliveryDate"
                                       class="form-label fw-semibold">

                                    Delivery Date

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-calendar-check"></i>
                                    </span>

                                    <input asp-for="DeliveryDate"
                                           type="date"
                                           class="form-control" />

                                </div>

                                <span asp-validation-for="DeliveryDate"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Status & Cost -->

                        <div class="section-title mb-4 mt-2">

                            <div class="section-number">
                                03
                            </div>

                            <div>
                                <h5 class="mb-0">
                                    Repair Status
                                </h5>

                                <small class="text-muted">
                                    Set the current repair status and cost
                                </small>
                            </div>

                        </div>


                        <div class="row">

                            <!-- Status -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="Status"
                                       class="form-label fw-semibold">

                                    Status

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-clipboard-check"></i>
                                    </span>

                                    <select asp-for="Status"
                                            class="form-select">

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="In Progress">
                                            In Progress
                                        </option>

                                        <option value="Completed">
                                            Completed
                                        </option>

                                    </select>

                                </div>

                                <span asp-validation-for="Status"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- Cost -->

                            <div class="col-md-6 mb-4">

                                <label asp-for="Cost"
                                       class="form-label fw-semibold">

                                    Cost

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-currency-dollar"></i>
                                    </span>

                                    <input asp-for="Cost"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           placeholder="Enter repair cost" />

                                </div>

                                <span asp-validation-for="Cost"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Description -->

                        <div class="section-title mb-4 mt-2">

                            <div class="section-number">
                                04
                            </div>

                            <div>
                                <h5 class="mb-0">
                                    Problem Description
                                </h5>

                                <small class="text-muted">
                                    Describe the repair problem
                                </small>
                            </div>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe the repair problem..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex flex-column flex-sm-row
                                    justify-content-between
                                    gap-3 mt-4 pt-4 border-top">

                            <a asp-action="Index"
                               class="btn btn-light px-4">

                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Repair Orders

                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-check-lg me-2"></i>
                                Save Repair Order

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}