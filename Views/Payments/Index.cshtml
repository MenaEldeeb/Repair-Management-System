@model IEnumerable<FinalProject.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="container py-5">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                mb-4 gap-3">

        <div class="text-center text-md-start">

            <div class="page-icon mb-3">
                <i class="bi bi-credit-card"></i>
            </div>

            <h2 class="fw-bold mb-1">
                Payments
            </h2>

            <p class="text-muted mb-0">
                View and manage all repair payments.
            </p>

        </div>

    </div>


    <!-- PAYMENTS TABLE -->
    <div class="card form-card border-0">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>

                                    <th>ID</th>

                                    <th>Repair Order</th>

                                    <th>Amount</th>

                                    <th>Payment Method</th>

                                    <th>Payment Date</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>
                            </thead>


                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <!-- ID -->
                                            <td>
                                                <span class="customer-id">
                                                    #@item.PaymentId
                                                </span>
                                            </td>


                                            <!-- REPAIR ORDER -->
                                            <td>

                                        @if (item.RepairOrder != null)
                                        {
                                                        <span class="fw-semibold">
                                                            Order #@item.RepairOrder.RepairOrderId
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            No Order
                                                        </span>
                                        }

                                            </td>


                                            <!-- AMOUNT -->
                                            <td>

                                                <span class="fw-semibold">
                                            @item.Amount.ToString("0.00") EGP
                                                </span>

                                            </td>


                                            <!-- PAYMENT METHOD -->
                                            <td>

                                        @if (item.PaymentMethod == "Cash")
                                        {
                                                        <span class="badge bg-success">
                                                            <i class="bi bi-cash me-1"></i>
                                                            Cash
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="badge bg-primary">
                                                @item.PaymentMethod
                                                        </span>
                                        }

                                            </td>


                                            <!-- PAYMENT DATE -->
                                            <td>

                                                <i class="bi bi-calendar3 me-1 text-muted"></i>

                                        @item.PaymentDate.ToString("dd/MM/yyyy")

                                            </td>


                                            <!-- ACTIONS -->
                                            <td>

                                                <div class="d-flex
                                                    justify-content-center
                                                    gap-2">

                                                    <a asp-action="Details"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-info action-btn">

                                                        <i class="bi bi-eye me-1"></i>
                                                        Details

                                                    </a>


                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-warning action-btn">

                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Edit

                                                    </a>


                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-danger action-btn">

                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }
            else
            {
                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">
                            <i class="bi bi-credit-card"></i>
                        </div>

                        <h4 class="fw-bold">
                            No Payments Found
                        </h4>

                        <p class="text-muted mb-0">
                            No payments have been recorded yet.
                        </p>

                    </div>
            }

        </div>

    </div>

</div>