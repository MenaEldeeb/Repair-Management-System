@model IEnumerable<FinalProject.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<div class="container py-5">

    <!-- Page Header -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                mb-4 gap-3">

        <div class="d-flex align-items-center">

            <div class="page-icon me-3">
                <i class="bi bi-credit-card"></i>
            </div>

            <div>

                <h2 class="fw-bold mb-1">
                    Payments
                </h2>

                <p class="text-muted mb-0">
                    Manage repair payments and transactions.
                </p>

            </div>

        </div>

        <a asp-action="Create"
           class="btn btn-primary px-4">

            <i class="bi bi-plus-lg me-2"></i>
            Add Payment

        </a>

    </div>


    <!-- Payments Table -->

    <div class="card form-card border-0">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0 customers-table">

                            <thead>

                                <tr>

                                    <th>ID</th>

                                    <th>Repair Order</th>

                                    <th>Amount</th>

                                    <th>Payment Date</th>

                                    <th>Method</th>

                                    <th class="text-center">
                                        Actions
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <!-- ID -->

                                            <td>

                                                <span class="customer-id">
                                                    #@item.PaymentId
                                                </span>

                                            </td>


                                            <!-- Repair Order -->

                                            <td>

                                                <span class="fw-semibold">
                                                    Repair Order #@item.RepairOrderId
                                                </span>

                                            </td>


                                            <!-- Amount -->

                                            <td>

                                                <span class="fw-bold text-success">
                                            @item.Amount.ToString("C")
                                                </span>

                                            </td>


                                            <!-- Payment Date -->

                                            <td>

                                                <i class="bi bi-calendar3 me-1 text-muted"></i>

                                        @item.PaymentDate.ToString("dd MMM yyyy")

                                            </td>


                                            <!-- Payment Method -->

                                            <td>

                                                <span class="badge bg-primary">
                                            @item.PaymentMethod
                                                </span>

                                            </td>


                                            <!-- Actions -->

                                            <td>

                                                <div class="d-flex
                                                    justify-content-center
                                                    gap-2">

                                                    <a asp-action="Details"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-info action-btn">

                                                        <i class="bi bi-eye me-1"></i>
                                                        Details

                                                    </a>


                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-warning action-btn">

                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Edit

                                                    </a>


                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.PaymentId"
                                                       class="btn btn-danger action-btn">

                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }
            else
            {
                    <!-- Empty State -->

                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">

                            <i class="bi bi-credit-card"></i>

                        </div>

                        <h4 class="fw-bold">
                            No Payments Found
                        </h4>

                        <p class="text-muted">
                            You haven't added any payments yet.
                        </p>

                        <a asp-action="Create"
                           class="btn btn-primary px-4">

                            <i class="bi bi-plus-lg me-2"></i>
                            Add Your First Payment

                        </a>

                    </div>
            }

        </div>

    </div>

</div>
