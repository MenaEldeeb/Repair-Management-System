@model FinalProject.Models.Payment

@{
    ViewData["Title"] = "Make Payment";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4 p-md-5">


                    <!-- HEADER -->

                    <div class="text-center mb-4">

                        <div class="display-5 text-success mb-3">

                            <i class="bi bi-credit-card"></i>

                        </div>

                        <h2 class="fw-bold">
                            Make Payment
                        </h2>

                        <p class="text-muted mb-0">
                            Complete your repair payment.
                        </p>

                    </div>


                    <!-- PAYMENT FORM -->

                    <form asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- IDs -->

                        <input type="hidden"
                               asp-for="RepairOrderId" />

                        <input type="hidden"
                               asp-for="Amount" />


                        <!-- AMOUNT -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Repair Cost

                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text">

                                    <i class="bi bi-cash-stack"></i>

                                </span>

                                <input value="@Model.Amount.ToString("0.00") EGP"
                                       class="form-control"
                                       readonly />

                            </div>

                            <small class="text-muted">

                                The payment amount is based on your repair order.

                            </small>

                        </div>


                        <!-- PAYMENT METHOD -->

                        <div class="mb-4">

                            <label asp-for="PaymentMethod"
                                   class="form-label fw-semibold">

                                Payment Method

                            </label>


                            <select asp-for="PaymentMethod"
                                    class="form-select form-select-lg">

                                <option value="Cash">

                                    Cash

                                </option>

                                <option value="Card">

                                    Card

                                </option>

                            </select>

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- PAYMENT DATE -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Payment Date

                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@DateTime.Now.ToString("dd/MM/yyyy")"
                                   readonly />

                        </div>


                        <!-- BUTTONS -->

                        <div class="d-grid gap-2">

                            <button type="submit"
                                    class="btn btn-success btn-lg">

                                <i class="bi bi-check-circle me-2"></i>

                                Confirm Payment

                            </button>


                            <a asp-controller="CustomerRepair"
                               asp-action="Track"
                               class="btn btn-outline-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}