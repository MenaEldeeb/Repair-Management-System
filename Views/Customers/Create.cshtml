@model FinalProject.Models.Customer

@{
    ViewData["Title"] = "Add Customer";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-9">

            <!-- Page Header -->
            <div class="d-flex align-items-center mb-4">
                <div class="page-icon me-3">
                    <i class="bi bi-person-plus-fill"></i>
                </div>

                <div>
                    <h2 class="fw-bold mb-1">Add New Customer</h2>
                    <p class="text-muted mb-0">
                        Create a customer profile for the repair service.
                    </p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card form-card border-0">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- Personal Information -->
                        <div class="section-title mb-4">
                            <div class="section-number">01</div>

                            <div>
                                <h5 class="mb-0">Personal Information</h5>
                                <small class="text-muted">
                                    Enter the customer's basic details
                                </small>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <label asp-for="Fname" class="form-label">
                                    First Name
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <input asp-for="Fname"
                                           class="form-control"
                                           placeholder="Enter first name" />
                                </div>

                                <span asp-validation-for="Fname"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Lname" class="form-label">
                                    Last Name
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-person"></i>
                                    </span>

                                    <input asp-for="Lname"
                                           class="form-control"
                                           placeholder="Enter last name" />
                                </div>

                                <span asp-validation-for="Lname"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <!-- Contact Information -->
                        <div class="section-title mb-4 mt-2">
                            <div class="section-number">02</div>

                            <div>
                                <h5 class="mb-0">Contact Information</h5>
                                <small class="text-muted">
                                    Customer contact details
                                </small>
                            </div>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label">
                                    Phone Number
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-telephone"></i>
                                    </span>

                                    <input asp-for="Phone"
                                           class="form-control"
                                           placeholder="01XXXXXXXXX" />
                                </div>

                                <span asp-validation-for="Phone"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label">
                                    Email Address
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="Email"
                                           type="email"
                                           class="form-control"
                                           placeholder="example@email.com" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>
                            </div>

                        </div>

                        <!-- Address -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label">
                                Address
                            </label>

                            <div class="input-group">
                                <span class="input-group-text align-items-start pt-3">
                                    <i class="bi bi-geo-alt"></i>
                                </span>

                                <textarea asp-for="Address"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Enter customer address"></textarea>
                            </div>

                            <span asp-validation-for="Address"
                                  class="text-danger small">
                            </span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex flex-column flex-sm-row 
                                    justify-content-between gap-3 mt-4 pt-4 border-top">

                            <a asp-action="Index"
                               class="btn btn-light px-4">
                                <i class="bi bi-arrow-left me-2"></i>
                                Back to Customers
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-2"></i>
                                Save Customer
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}