
@model IEnumerable<FinalProject.Models.Customer>

@{
    ViewData["Title"] = "Customers";
}

<div class="container py-5">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div class="d-flex align-items-center">
            <div class="page-icon me-3">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <h2 class="fw-bold mb-1">Customers</h2>

                <p class="text-muted mb-0">
                    Manage all customers and their information.
                </p>
            </div>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-person-plus-fill me-2"></i>
            Add Customer
        </a>

    </div>


    <!-- Customers Card -->
    <div class="card form-card border-0">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0 customers-table">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Address</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>


                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <!-- ID -->
                                            <td>
                                                <span class="customer-id">
                                                    #@item.CustomerId
                                                </span>
                                            </td>


                                            <!-- Customer -->
                                            <td>
                                                <div class="d-flex align-items-center">

                                                    <div class="customer-avatar">
                                                @item.Fname.Substring(0, 1).ToUpper()
                                                    </div>

                                                    <div class="ms-3">

                                                        <div class="fw-semibold">
                                                    @item.Fname @item.Lname
                                                        </div>

                                                        <small class="text-muted">
                                                            Customer
                                                        </small>

                                                    </div>

                                                </div>
                                            </td>


                                            <!-- Phone -->
                                            <td>
                                                <i class="bi bi-telephone me-1 text-muted"></i>
                                        @item.Phone
                                            </td>


                                            <!-- Email -->
                                            <td>
                                                <i class="bi bi-envelope me-1 text-muted"></i>
                                        @item.Email
                                            </td>


                                            <!-- Address -->
                                            <td>

                                                <span class="text-truncate d-inline-block"
                                                      style="max-width: 180px;">

                                            @item.Address

                                                </span>

                                            </td>


                                            <!-- Actions -->
                                            <td>

                                                <div class="d-flex justify-content-center gap-2">

                                                    <!-- Details -->
                                                    <a asp-action="Details"
                                                       asp-route-id="@item.CustomerId"
                                                       class="btn btn-info action-btn"
                                                       title="Details">

                                                        <i class="bi bi-eye me-1"></i>
                                                        Details

                                                    </a>


                                                    <!-- Edit -->
                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.CustomerId"
                                                       class="btn btn-warning action-btn"
                                                       title="Edit">

                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Edit

                                                    </a>


                                                    <!-- Delete -->
                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.CustomerId"
                                                       class="btn btn-danger action-btn"
                                                       title="Delete">

                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete

                                                    </a>

                                                </div>

                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }

            else
            {
                    <!-- Empty State -->

                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">

                            <i class="bi bi-people"></i>

                        </div>


                        <h4 class="fw-bold">
                            No Customers Found
                        </h4>


                        <p class="text-muted">
                            You haven't added any customers yet.
                        </p>


                        <a asp-action="Create"
                           class="btn btn-primary px-4">

                            <i class="bi bi-person-plus-fill me-2"></i>

                            Add Your First Customer

                        </a>

                    </div>
            }

        </div>

    </div>

</div>