@model FinalProject.Models.Payment

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Edit Payment";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <!-- HEADER -->

            <div class="text-center mb-4">

                <div class="display-5 text-primary mb-3">

                    <i class="bi bi-pencil-square"></i>

                </div>

                <h2 class="fw-bold">
                    Edit Payment
                </h2>

                <p class="text-muted">
                    Update your payment method.
                </p>

            </div>


            <!-- CARD -->

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">


                    <!-- PAYMENT INFO -->

                    <div class="alert alert-info">

                        <i class="bi bi-info-circle me-2"></i>

                        You can only change the payment method.

                    </div>


                    <!-- FORM -->

                    <form asp-controller="CustomerPayment"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- PAYMENT ID -->

                        <input type="hidden"
                               asp-for="PaymentId" />


                        <!-- REPAIR ORDER -->

                        <input type="hidden"
                               asp-for="RepairOrderId" />


                        <!-- PHONE -->

                        <input type="hidden"
                               name="phone"
                               value="@Model.RepairOrder?.Device?.Customer?.Phone" />


                        <!-- PAYMENT ID DISPLAY -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Payment ID
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="#@Model.PaymentId"
                                   readonly />

                        </div>


                        <!-- AMOUNT -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Amount
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <i class="bi bi-cash-stack"></i>
                                </span>

                                <input type="text"
                                       class="form-control"
                                       value="@Model.Amount.ToString("0.00") EGP"
                                       readonly />

                            </div>

                        </div>


                        <!-- PAYMENT METHOD -->

                        <div class="mb-4">

                            <label asp-for="PaymentMethod"
                                   class="form-label fw-semibold">

                                Payment Method

                            </label>

                            <select asp-for="PaymentMethod"
                                    class="form-select form-select-lg">

                                <option value="Cash">
                                    Cash
                                </option>

                                <option value="Card">
                                    Card
                                </option>

                            </select>

                            <span asp-validation-for="PaymentMethod"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- DATE -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Payment Date
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.PaymentDate.ToString("dd/MM/yyyy")"
                                   readonly />

                        </div>


                        <!-- BUTTONS -->

                        <div class="d-flex flex-column
                                    flex-sm-row
                                    gap-2">


                            <button type="submit"
                                    class="btn btn-primary flex-fill">

                                <i class="bi bi-check-circle me-2"></i>

                                Save Changes

                            </button>


                            <a asp-controller="CustomerRepair"
                               asp-action="TrackResult"
                               asp-route-id="@Model.RepairOrderId"
                               asp-route-phone="@Model.RepairOrder?.Device?.Customer?.Phone"
                               class="btn btn-outline-secondary flex-fill">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}
