@model IEnumerable<FinalProject.Models.Technician>

@{
    ViewData["Title"] = "Technicians";
}

<div class="container py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div class="d-flex align-items-center">

            <div class="page-icon me-3">
                <i class="bi bi-person-gear"></i>
            </div>

            <div>
                <h2 class="fw-bold mb-1">Technicians</h2>

                <p class="text-muted mb-0">
                    Manage technicians and their information.
                </p>
            </div>

        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>
            Add Technician
        </a>

    </div>


    <div class="card form-card border-0">

        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Technician</th>
                                    <th>Phone</th>
                                    <th>Specialization</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>

                            <tbody>

                            @foreach (var item in Model)
                            {
                                        <tr>

                                            <td>
                                                <span class="customer-id">
                                                    #@item.TechnicianId
                                                </span>
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">

                                                    <div class="customer-avatar">
                                                @(string.IsNullOrEmpty(item.Name)
                                                        ? "T"
                                                        : item.Name.Substring(0, 1).ToUpper())
                                                    </div>

                                                    <div class="ms-3">
                                                        <div class="fw-semibold">
                                                    @item.Name
                                                        </div>

                                                        <small class="text-muted">
                                                            Technician
                                                        </small>
                                                    </div>

                                                </div>
                                            </td>

                                            <td>
                                                <i class="bi bi-telephone me-1 text-muted"></i>
                                        @item.Phone
                                            </td>

                                            <td>
                                        @if (!string.IsNullOrEmpty(item.Specialization))
                                        {
                                                        <span class="badge bg-primary">
                                                @item.Specialization
                                                        </span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">
                                                            General
                                                        </span>
                                        }
                                            </td>

                                            <td>
                                                <div class="d-flex justify-content-center gap-2">

                                                    <a asp-action="Details"
                                                       asp-route-id="@item.TechnicianId"
                                                       class="btn btn-info action-btn">

                                                        <i class="bi bi-eye me-1"></i>
                                                        Details

                                                    </a>

                                                    <a asp-action="Edit"
                                                       asp-route-id="@item.TechnicianId"
                                                       class="btn btn-warning action-btn">

                                                        <i class="bi bi-pencil-square me-1"></i>
                                                        Edit

                                                    </a>

                                                    <a asp-action="Delete"
                                                       asp-route-id="@item.TechnicianId"
                                                       class="btn btn-danger action-btn">

                                                        <i class="bi bi-trash me-1"></i>
                                                        Delete

                                                    </a>

                                                </div>
                                            </td>

                                        </tr>
                            }

                            </tbody>

                        </table>

                    </div>
            }
            else
            {
                    <div class="text-center py-5">

                        <div class="empty-icon mb-3">
                            <i class="bi bi-person-gear"></i>
                        </div>

                        <h4 class="fw-bold">
                            No Technicians Found
                        </h4>

                        <p class="text-muted">
                            You haven't added any technicians yet.
                        </p>

                        <a asp-action="Create" class="btn btn-primary px-4">
                            <i class="bi bi-plus-lg me-2"></i>
                            Add Your First Technician
                        </a>

                    </div>
            }

        </div>

    </div>

</div>
