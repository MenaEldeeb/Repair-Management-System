@model FinalProject.Models.Technician

@{
    ViewData["Title"] = "Delete Technician";
}

<div class="container py-5">

    <!-- Page Header -->
  <div class="text-center mb-4">

    <div class="page-icon mx-auto mb-3">
        <i class="bi bi-trash"></i>
    </div>

    <div>
        <h2 class="fw-bold mb-1">
            Delete Technician
        </h2>

        <p class="text-muted mb-0">
            Remove this technician from the system.
        </p>
    </div>

</div>

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card form-card border-0">

                <div class="card-body p-4 p-md-5">

                    <!-- Warning -->

                    <div class="text-center mb-4">

                        <div class="empty-icon mb-3">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <h4 class="fw-bold">
                            Are you sure?
                        </h4>

                        <p class="text-muted">
                            You are about to delete this technician.
                            This action cannot be undone.
                        </p>

                    </div>


                    <!-- Technician Information -->

                    <div class="p-4 border rounded mb-4">

                        <div class="d-flex align-items-center">

                            <div class="customer-avatar">

                                @(string.IsNullOrEmpty(Model.Name)
                                        ? "T"
                                        : Model.Name.Substring(0, 1).ToUpper())

                            </div>

                            <div class="ms-3">

                                <h5 class="fw-bold mb-1">
                                    @Model.Name
                                </h5>

                                <small class="text-muted">
                                    Technician #@Model.TechnicianId
                                </small>

                            </div>

                        </div>


                        <hr />


                        <div class="row g-3">

                            <div class="col-md-6">

                                <small class="text-muted d-block">
                                    Phone
                                </small>

                                <span class="fw-semibold">
                                    @Model.Phone
                                </span>

                            </div>

                            <div class="col-md-6">

                                <small class="text-muted d-block">
                                    Specialization
                                </small>

                                <span class="fw-semibold">
                                    @(string.IsNullOrEmpty(Model.Specialization)
                                            ? "General"
                                            : Model.Specialization)
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- Delete Form -->

                    <form asp-action="DeleteConfirmed"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.TechnicianId" />

                        <div class="d-flex flex-column flex-sm-row
                                    justify-content-between
                                    gap-3
                                    pt-4 border-top">

                            <a asp-action="Index"
                               class="btn btn-light px-4">

                                <i class="bi bi-arrow-left me-2"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash me-2"></i>
                                Delete Technician

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
