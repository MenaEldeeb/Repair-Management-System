@model IEnumerable<FinalProject.Models.RepairOrder>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Dashboard";

    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var totalDevices = ViewBag.TotalDevices ?? 0;
    var totalTechnicians = ViewBag.TotalTechnicians ?? 0;
    var totalRepairOrders = ViewBag.TotalRepairOrders ?? 0;

    var pendingRepairs = ViewBag.PendingRepairs ?? 0;
    var inProgressRepairs = ViewBag.InProgressRepairs ?? 0;
    var completedRepairs = ViewBag.CompletedRepairs ?? 0;

    var totalPayments = ViewBag.TotalPayments ?? 0;
}


<div class="container-fluid py-4">


    <!-- =====================================================
         DASHBOARD HEADER
    ====================================================== -->

    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3 mb-4">


        <div>

            <span class="text-primary fw-bold small">
                ADMIN DASHBOARD
            </span>

            <h1 class="fw-bold mb-1 mt-1">
                Welcome to RepairHub
            </h1>

            <p class="text-muted mb-0">
                Monitor and manage your repair center.
            </p>

        </div>


        <div class="d-flex gap-2">

            <a asp-controller="Customers"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-people me-1"></i>

                Customers

            </a>


            <a asp-controller="RepairOrders"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-lg me-1"></i>

                New Repair

            </a>

        </div>

    </div>



    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- CUSTOMERS -->

        <div class="col-sm-6 col-xl-3">

            <a asp-controller="Customers"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-stat-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start">


                            <div>

                                <p class="text-muted
                                          small fw-semibold mb-2">

                                    TOTAL CUSTOMERS

                                </p>

                                <h2 class="fw-bold text-dark mb-1">

                                    @totalCustomers

                                </h2>

                                <small class="text-muted">

                                    Registered customers

                                </small>

                            </div>


                            <div class="stat-icon
                                        bg-primary bg-opacity-10
                                        text-primary">

                                <i class="bi bi-people"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>



        <!-- DEVICES -->

        <div class="col-sm-6 col-xl-3">

            <a asp-controller="Devices"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-stat-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start">


                            <div>

                                <p class="text-muted
                                          small fw-semibold mb-2">

                                    TOTAL DEVICES

                                </p>

                                <h2 class="fw-bold text-dark mb-1">

                                    @totalDevices

                                </h2>

                                <small class="text-muted">

                                    Devices in system

                                </small>

                            </div>


                            <div class="stat-icon
                                        bg-info bg-opacity-10
                                        text-info">

                                <i class="bi bi-laptop"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>



        <!-- TECHNICIANS -->

        <div class="col-sm-6 col-xl-3">

            <a asp-controller="Technicians"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-stat-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start">


                            <div>

                                <p class="text-muted
                                          small fw-semibold mb-2">

                                    TECHNICIANS

                                </p>

                                <h2 class="fw-bold text-dark mb-1">

                                    @totalTechnicians

                                </h2>

                                <small class="text-muted">

                                    Available technicians

                                </small>

                            </div>


                            <div class="stat-icon
                                        bg-warning bg-opacity-10
                                        text-warning">

                                <i class="bi bi-person-gear"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>



        <!-- REPAIR ORDERS -->

        <div class="col-sm-6 col-xl-3">

            <a asp-controller="RepairOrders"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card dashboard-stat-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="d-flex
                                    justify-content-between
                                    align-items-start">


                            <div>

                                <p class="text-muted
                                          small fw-semibold mb-2">

                                    REPAIR ORDERS

                                </p>

                                <h2 class="fw-bold text-dark mb-1">

                                    @totalRepairOrders

                                </h2>

                                <small class="text-muted">

                                    Total repair orders

                                </small>

                            </div>


                            <div class="stat-icon
                                        bg-success bg-opacity-10
                                        text-success">

                                <i class="bi bi-tools"></i>

                            </div>

                        </div>

                    </div>

                </div>

            </a>

        </div>

    </div>



    <!-- =====================================================
         MAIN DASHBOARD ROW
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- REPAIR STATUS -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">


                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                mb-4">


                        <div>

                            <span class="text-primary
                                         small fw-bold">

                                REPAIR WORKFLOW

                            </span>

                            <h4 class="fw-bold mb-0 mt-1">

                                Current Repair Status

                            </h4>

                        </div>


                        <a asp-controller="RepairOrders"
                           asp-action="Index"
                           class="btn btn-sm
                                  btn-outline-primary">

                            View All

                            <i class="bi bi-arrow-right ms-1"></i>

                        </a>

                    </div>



                    <div class="row g-3">


                        <!-- PENDING -->

                        <div class="col-md-4">

                            <div class="status-box
                                        border-start
                                        border-warning
                                        border-4">

                                <div class="d-flex
                                            align-items-center
                                            gap-3">


                                    <div class="status-icon
                                                bg-warning
                                                bg-opacity-10
                                                text-warning">

                                        <i class="bi bi-clock"></i>

                                    </div>


                                    <div>

                                        <small class="text-muted">
                                            Pending
                                        </small>

                                        <h3 class="fw-bold mb-0">

                                            @pendingRepairs

                                        </h3>

                                    </div>

                                </div>


                                <small class="text-muted d-block mt-3">

                                    Waiting for repair

                                </small>

                            </div>

                        </div>



                        <!-- IN PROGRESS -->

                        <div class="col-md-4">

                            <div class="status-box
                                        border-start
                                        border-primary
                                        border-4">

                                <div class="d-flex
                                            align-items-center
                                            gap-3">


                                    <div class="status-icon
                                                bg-primary
                                                bg-opacity-10
                                                text-primary">

                                        <i class="bi bi-wrench-adjustable"></i>

                                    </div>


                                    <div>

                                        <small class="text-muted">
                                            In Progress
                                        </small>

                                        <h3 class="fw-bold mb-0">

                                            @inProgressRepairs

                                        </h3>

                                    </div>

                                </div>


                                <small class="text-muted d-block mt-3">

                                    Currently being repaired

                                </small>

                            </div>

                        </div>



                        <!-- COMPLETED -->

                        <div class="col-md-4">

                            <div class="status-box
                                        border-start
                                        border-success
                                        border-4">

                                <div class="d-flex
                                            align-items-center
                                            gap-3">


                                    <div class="status-icon
                                                bg-success
                                                bg-opacity-10
                                                text-success">

                                        <i class="bi bi-check-circle"></i>

                                    </div>


                                    <div>

                                        <small class="text-muted">
                                            Completed
                                        </small>

                                        <h3 class="fw-bold mb-0">

                                            @completedRepairs

                                        </h3>

                                    </div>

                                </div>


                                <small class="text-muted d-block mt-3">

                                    Completed repairs

                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- PAYMENTS -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm
                        h-100 payment-card">


                <div class="card-body p-4
                            d-flex flex-column">


                    <div class="payment-big-icon
                                bg-primary
                                bg-opacity-10
                                text-primary">

                        <i class="bi bi-wallet2"></i>

                    </div>


                    <span class="text-muted
                                 small fw-semibold mt-4">

                        TOTAL PAYMENTS

                    </span>


                    <h2 class="fw-bold mt-2">

                        @String.Format(
                                     "{0:N2}",
                                     totalPayments
                                 )

                    </h2>


                    <p class="text-muted small">

                        Total recorded repair payments.

                    </p>


                    <div class="mt-auto">

                        <a asp-controller="Payments"
                           asp-action="Index"
                           class="btn btn-primary w-100">

                            Manage Payments

                            <i class="bi bi-arrow-right ms-1"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         RECENT REPAIR ORDERS
    ====================================================== -->

    <div class="card border-0 shadow-sm mb-4">


        <div class="card-body p-4">


            <div class="d-flex
                        justify-content-between
                        align-items-center
                        mb-4">


                <div>

                    <span class="text-primary
                                 small fw-bold">

                        REPAIR DESK

                    </span>

                    <h4 class="fw-bold mb-0 mt-1">

                        Recent Repair Orders

                    </h4>

                </div>


                <a asp-controller="RepairOrders"
                   asp-action="Index"
                   class="btn btn-sm
                          btn-outline-primary">

                    View All

                    <i class="bi bi-arrow-right ms-1"></i>

                </a>

            </div>



            @if (Model != null && Model.Any())
            {

                    <div class="table-responsive">

                        <table class="table align-middle
                                  table-hover mb-0">


                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Order
                                    </th>

                                    <th>
                                        Device
                                    </th>

                                    <th>
                                        Technician
                                    </th>

                                    <th>
                                        Received
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-end">
                                        Cost
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                            @foreach (var order in Model)
                            {

                                var status =
                                    order.Status ?? "Pending";


                                var statusClass =
                                    status == "Completed"
                                        ? "bg-success-subtle text-success"
                                        : status == "In Progress"
                                            ? "bg-primary-subtle text-primary"
                                            : "bg-warning-subtle text-warning";


                                    <tr>


                                        <!-- ORDER -->

                                        <td>

                                            <span class="fw-bold">

                                                #@order.RepairOrderId

                                            </span>

                                        </td>



                                        <!-- DEVICE -->

                                        <td>

                                            <div class="d-flex
                                                align-items-center
                                                gap-2">


                                                <div class="table-icon">

                                                    <i class="bi bi-laptop"></i>

                                                </div>


                                                <div>

                                                    <div class="fw-semibold">

                                                    @(order.Device?.DeviceName
                                                            ?? "Unknown Device")

                                                    </div>

                                                    <small class="text-muted">

                                                    @(order.Device?.DeviceType
                                                            ?? "Device")

                                                    </small>

                                                </div>

                                            </div>

                                        </td>



                                        <!-- TECHNICIAN -->

                                        <td>

                                        @(order.Technician?.Name
                                                ?? "Not assigned")

                                        </td>



                                        <!-- DATE -->

                                        <td>

                                        @order.ReceiveDate.ToString(
                                                     "dd MMM yyyy"
                                                 )

                                        </td>



                                        <!-- STATUS -->

                                        <td>

                                            <span class="badge rounded-pill
                                                 @statusClass
                                                 px-3 py-2">

                                            @status

                                            </span>

                                        </td>



                                        <!-- COST -->

                                        <td class="text-end">

                                            <strong>

                                            @String.Format(
                                                         "{0:N2}",
                                                         order.Cost
                                                     )

                                            </strong>

                                        </td>

                                    </tr>

                            }

                            </tbody>

                        </table>

                    </div>

            }
            else
            {

                    <div class="text-center py-5">

                        <div class="empty-icon
                                bg-light
                                text-muted">

                            <i class="bi bi-tools"></i>

                        </div>


                        <h5 class="fw-bold mt-3">

                            No Repair Orders Yet

                        </h5>


                        <p class="text-muted">

                            Start by creating your first repair order.

                        </p>


                        <a asp-controller="RepairOrders"
                           asp-action="Create"
                           class="btn btn-primary">

                            <i class="bi bi-plus-lg me-1"></i>

                            Create Repair

                        </a>

                    </div>

            }

        </div>

    </div>



    <!-- =====================================================
         QUICK ACTIONS
    ====================================================== -->

    <div class="row g-4">


        <!-- QUICK ACTIONS -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">


                    <span class="text-primary
                                 small fw-bold">

                        QUICK ACTIONS

                    </span>


                    <h4 class="fw-bold mt-1 mb-4">

                        Manage Your Repair Center

                    </h4>


                    <div class="row g-3">


                        <!-- CUSTOMER -->

                        <div class="col-md-6">

                            <a asp-controller="Customers"
                               asp-action="Create"
                               class="quick-action">

                                <div class="quick-action-icon
                                            bg-primary
                                            bg-opacity-10
                                            text-primary">

                                    <i class="bi bi-person-plus"></i>

                                </div>


                                <div>

                                    <strong>
                                        Add Customer
                                    </strong>

                                    <small>
                                        Register a new customer
                                    </small>

                                </div>


                                <i class="bi bi-chevron-right ms-auto"></i>

                            </a>

                        </div>



                        <!-- DEVICE -->

                        <div class="col-md-6">

                            <a asp-controller="Devices"
                               asp-action="Create"
                               class="quick-action">

                                <div class="quick-action-icon
                                            bg-info
                                            bg-opacity-10
                                            text-info">

                                    <i class="bi bi-laptop"></i>

                                </div>


                                <div>

                                    <strong>
                                        Add Device
                                    </strong>

                                    <small>
                                        Register a customer device
                                    </small>

                                </div>


                                <i class="bi bi-chevron-right ms-auto"></i>

                            </a>

                        </div>



                        <!-- TECHNICIAN -->

                        <div class="col-md-6">

                            <a asp-controller="Technicians"
                               asp-action="Create"
                               class="quick-action">

                                <div class="quick-action-icon
                                            bg-warning
                                            bg-opacity-10
                                            text-warning">

                                    <i class="bi bi-person-gear"></i>

                                </div>


                                <div>

                                    <strong>
                                        Add Technician
                                    </strong>

                                    <small>
                                        Register a repair technician
                                    </small>

                                </div>


                                <i class="bi bi-chevron-right ms-auto"></i>

                            </a>

                        </div>



                        <!-- PAYMENT -->

                        <div class="col-md-6">

                            <a asp-controller="Payments"
                               asp-action="Create"
                               class="quick-action">

                                <div class="quick-action-icon
                                            bg-success
                                            bg-opacity-10
                                            text-success">

                                    <i class="bi bi-credit-card"></i>

                                </div>


                                <div>

                                    <strong>
                                        Add Payment
                                    </strong>

                                    <small>
                                        Record a customer payment
                                    </small>

                                </div>


                                <i class="bi bi-chevron-right ms-auto"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- SYSTEM STATUS -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">


                <div class="card-body p-4">


                    <div class="d-flex
                                align-items-center
                                gap-3 mb-4">


                        <div class="system-icon
                                    bg-success
                                    bg-opacity-10
                                    text-success">

                            <i class="bi bi-shield-check"></i>

                        </div>


                        <div>

                            <h5 class="fw-bold mb-0">

                                System Status

                            </h5>

                            <small class="text-muted">

                                RepairHub

                            </small>

                        </div>

                    </div>



                    <div class="system-status-row">

                        <span>

                            <i class="bi bi-circle-fill
                                      text-success me-2"></i>

                            Application

                        </span>

                        <strong class="text-success">

                            Online

                        </strong>

                    </div>


                    <div class="system-status-row">

                        <span>

                            <i class="bi bi-circle-fill
                                      text-success me-2"></i>

                            Database

                        </span>

                        <strong class="text-success">

                            Connected

                        </strong>

                    </div>


                    <div class="system-status-row">

                        <span>

                            <i class="bi bi-circle-fill
                                      text-success me-2"></i>

                            Repair Service

                        </span>

                        <strong class="text-success">

                            Ready

                        </strong>

                    </div>


                </div>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     DASHBOARD CSS
========================================================= -->

