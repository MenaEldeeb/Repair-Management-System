<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - RepairHub Admin
    </title>


    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =====================================================
           GENERAL
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #f5f7fb;
            color: #212529;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           TOP NAVBAR
        ===================================================== */

        .admin-navbar {
            position: fixed;

            top: 0;
            left: 0;
            right: 0;

            height: 70px;

            background: #111827;
            color: white;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 22px;

            z-index: 1050;

            box-shadow: 0 2px 12px rgba(0,0,0,.18);
        }


        .navbar-left {
            display: flex;
            align-items: center;
            gap: 14px;
        }


        /* =====================================================
           MENU BUTTON
        ===================================================== */

        .menu-btn {
            width: 42px;
            height: 42px;

            border: none;
            background: transparent;

            color: white;

            border-radius: 9px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 24px;

            cursor: pointer;

            transition: all .25s ease;
        }


        .menu-btn:hover {
            background: #1f2937;

            transform: scale(1.05);
        }


        /* =====================================================
           BRAND
        ===================================================== */

        .brand {
            color: white;

            text-decoration: none;

            font-size: 22px;
            font-weight: 700;

            display: flex;
            align-items: center;

            gap: 10px;
        }


        .brand:hover {
            color: white;
        }


        .brand-icon {
            width: 39px;
            height: 39px;

            background: #0d6efd;

            border-radius: 10px;

            display: flex;
            align-items: center;
            justify-content: center;

            transition: all .25s ease;
        }


        .brand:hover .brand-icon {
            transform: rotate(-5deg) scale(1.05);
        }


        /* =====================================================
           ADMIN INFO
        ===================================================== */

        .admin-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }


        .online {
            display: flex;
            align-items: center;

            gap: 7px;

            color: #d1d5db;

            font-size: 13px;
        }


        .online-dot {
            width: 9px;
            height: 9px;

            background: #22c55e;

            border-radius: 50%;

            box-shadow: 0 0 8px rgba(34,197,94,.7);
        }


        .admin-avatar {
            width: 39px;
            height: 39px;

            background: #374151;

            color: white;

            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            transition: all .25s ease;
        }


        .admin-avatar:hover {
            background: #4b5563;

            transform: scale(1.05);
        }


        /* =====================================================
           SIDEBAR
        ===================================================== */

        .sidebar {
            position: fixed;

            top: 70px;
            left: 0;
            bottom: 55px;

            width: 250px;

            background: #111827;

            color: white;

            z-index: 1040;

            overflow-y: auto;

            transition: all .3s ease;

            box-shadow: 2px 0 12px rgba(0,0,0,.15);
        }


        /* =====================================================
           SIDEBAR TITLE
        ===================================================== */

        .sidebar-title {
            padding: 25px 22px 12px;

            color: #9ca3af;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 1.5px;
        }


        /* =====================================================
           SIDEBAR SECTION
        ===================================================== */

        .sidebar-section {
            padding: 10px 22px;

            color: #6b7280;

            font-size: 10px;

            font-weight: 700;

            letter-spacing: 1.4px;
        }


        /* =====================================================
           SIDEBAR LINKS
        ===================================================== */

        .sidebar a {
            position: relative;

            text-decoration: none;

            color: #d1d5db;

            display: flex;
            align-items: center;

            gap: 13px;

            margin: 5px 12px;

            padding: 13px 15px;

            border-radius: 10px;

            font-size: 14px;

            font-weight: 500;

            transition: all .25s ease;

            overflow: hidden;
        }


        .sidebar a i {
            width: 22px;

            font-size: 18px;

            transition: all .25s ease;
        }


        /* =====================================================
           SIDEBAR HOVER
        ===================================================== */

        .sidebar a:hover {
            background: #1f2937;

            color: white;

            transform: translateX(5px);

            box-shadow:
                0 5px 15px rgba(0,0,0,.18);
        }


        .sidebar a:hover i {
            transform: scale(1.15);

            color: #60a5fa;
        }


        /* =====================================================
           ACTIVE LINK
        ===================================================== */

        .sidebar a.active {
            background: #0d6efd;

            color: white;

            box-shadow:
                0 5px 15px rgba(13,110,253,.3);
        }


        .sidebar a.active i {
            color: white;
        }


        .sidebar a.active:hover {
            background: #0b5ed7;

            transform: translateX(3px);
        }


        /* =====================================================
           DIVIDER
        ===================================================== */

        .sidebar-divider {
            height: 1px;

            background: #374151;

            margin: 18px;
        }


        /* =====================================================
           MAIN WRAPPER
        ===================================================== */

        .main-wrapper {
            margin-left: 250px;

            padding-top: 70px;
            padding-bottom: 55px;

            min-height: 100vh;

            transition: all .3s ease;
        }


        .main-content {
            padding: 30px;
        }


        /* =====================================================
           SIDEBAR CLOSED
        ===================================================== */

        .sidebar.closed {
            width: 0;

            overflow: hidden;
        }


        .main-wrapper.expanded {
            margin-left: 0;
        }


        /* =====================================================
           ALL CARDS HOVER
        ===================================================== */

        .card {
            transition:
                transform .25s ease,
                box-shadow .25s ease;
        }


        .card:hover {
            transform: translateY(-5px);

            box-shadow:
                0 10px 25px rgba(0,0,0,.10) !important;
        }


        /* =====================================================
           DASHBOARD STAT CARDS
        ===================================================== */

        .dashboard-stat-card {
            cursor: pointer;

            transition: all .25s ease;
        }


        .dashboard-stat-card:hover {
            transform: translateY(-7px);

            box-shadow:
                0 12px 28px rgba(0,0,0,.14) !important;
        }


        /* =====================================================
           QUICK ACTION
        ===================================================== */

        .quick-action {
            display: flex;
            align-items: center;

            gap: 14px;

            text-decoration: none;

            color: inherit;

            padding: 16px;

            border: 1px solid #e5e7eb;

            border-radius: 12px;

            transition: all .25s ease;
        }


        .quick-action:hover {
            color: inherit;

            transform: translateY(-4px);

            background: #f8fafc;

            box-shadow:
                0 8px 20px rgba(0,0,0,.10);
        }


        .quick-action small {
            display: block;

            color: #6b7280;

            margin-top: 3px;
        }


        .quick-action-icon {
            width: 45px;
            height: 45px;

            border-radius: 10px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 20px;

            transition: all .25s ease;
        }


        .quick-action:hover .quick-action-icon {
            transform: scale(1.1);
        }


        /* =====================================================
           STATUS BOX
        ===================================================== */

        .status-box {
            padding: 18px;

            border-radius: 10px;

            background: #fff;

            transition: all .25s ease;
        }


        .status-box:hover {
            transform: translateY(-4px);

            box-shadow:
                0 8px 18px rgba(0,0,0,.08);
        }


        .status-icon {
            width: 45px;
            height: 45px;

            border-radius: 10px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 20px;

            transition: all .25s ease;
        }


        .status-box:hover .status-icon {
            transform: scale(1.1);
        }


        /* =====================================================
           PAYMENT CARD
        ===================================================== */

        .payment-card {
            transition: all .25s ease;
        }


        .payment-card:hover {
            transform: translateY(-6px);

            box-shadow:
                0 12px 28px rgba(0,0,0,.14) !important;
        }


        .payment-big-icon {
            width: 55px;
            height: 55px;

            border-radius: 13px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 25px;

            transition: all .25s ease;
        }


        .payment-card:hover .payment-big-icon {
            transform: scale(1.1);
        }


        /* =====================================================
           TABLE
        ===================================================== */

        .table tbody tr {
            transition: all .2s ease;
        }


        .table tbody tr:hover {
            background: #f8fafc;

            transform: scale(1.005);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .admin-footer {
            position: fixed;

            left: 0;
            right: 0;
            bottom: 0;

            height: 55px;

            background: #111827;

            color: #9ca3af;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 25px;

            font-size: 13px;

            z-index: 1050;
        }


        .admin-footer strong {
            color: white;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

       @@media (max-width: 991px) {

            .sidebar {
                transform: translateX(-100%);

                width: 250px;
            }


            .sidebar.mobile-open {
                transform: translateX(0);
            }


            .main-wrapper {
                margin-left: 0;
            }


            .main-content {
                padding: 20px;
            }


            .online {
                display: none;
            }

        }


       @@media (max-width: 576px) {

            .admin-navbar {
                padding: 0 12px;
            }


            .brand {
                font-size: 18px;
            }


            .main-content {
                padding: 15px;
            }


            .admin-footer {
                padding: 0 12px;

                font-size: 11px;
            }


            .admin-footer span:last-child {
                display: none;
            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         TOP NAVBAR
    ===================================================== -->

    <header class="admin-navbar">


        <div class="navbar-left">


            <button type="button"
                    class="menu-btn"
                    id="menuButton">

                <i class="bi bi-list"></i>

            </button>


            <a asp-controller="Home"
               asp-action="Dashboard"
               class="brand">

                <span class="brand-icon">

                    <i class="bi bi-tools"></i>

                </span>

                RepairHub

            </a>


        </div>


        <div class="admin-info">


            <div class="online">

                <span class="online-dot"></span>

                System Online

            </div>


            <div class="admin-avatar">

                <i class="bi bi-person"></i>

            </div>


            <span class="d-none d-md-inline">

                Admin

            </span>


        </div>

    </header>



    <!-- =====================================================
         SIDEBAR
    ===================================================== -->

    <aside class="sidebar"
           id="sidebar">


        <div class="sidebar-title">

            ADMINISTRATION

        </div>


        <!-- DASHBOARD -->

        <a asp-controller="Home"
           asp-action="Dashboard">

            <i class="bi bi-grid-1x2-fill"></i>

            <span>
                Dashboard
            </span>

        </a>


        <div class="sidebar-section">

            MANAGEMENT

        </div>


        <!-- CUSTOMERS -->

        <a asp-controller="Customers"
           asp-action="Index">

            <i class="bi bi-people"></i>

            <span>
                Customers
            </span>

        </a>


        <!-- DEVICES -->

        <a asp-controller="Devices"
           asp-action="Index">

            <i class="bi bi-laptop"></i>

            <span>
                Devices
            </span>

        </a>


        <!-- TECHNICIANS -->

        <a asp-controller="Technicians"
           asp-action="Index">

            <i class="bi bi-person-gear"></i>

            <span>
                Technicians
            </span>

        </a>


        <!-- REPAIR ORDERS -->

        <a asp-controller="RepairOrders"
           asp-action="Index">

            <i class="bi bi-tools"></i>

            <span>
                Repair Orders
            </span>

        </a>


        <!-- PAYMENTS -->

        <a asp-controller="Payments"
           asp-action="Index">

            <i class="bi bi-credit-card"></i>

            <span>
                Payments
            </span>

        </a>


        <!-- REPORTS -->

        <a asp-controller="Reports"
           asp-action="Index">

            <i class="bi bi-bar-chart"></i>

            <span>
                Reports
            </span>

        </a>


        <div class="sidebar-divider"></div>


        <div class="sidebar-section">

            QUICK ACCESS

        </div>


        <!-- CUSTOMER SITE -->

        <a asp-controller="Home"
           asp-action="Index">

            <i class="bi bi-globe2"></i>

            <span>
                Customer Site
            </span>

        </a>


        <!-- LOGOUT -->

        <a asp-controller="Home"
           asp-action="AdminLogout">

            <i class="bi bi-box-arrow-right"></i>

            <span>
                Logout
            </span>

        </a>


    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ===================================================== -->

    <div class="main-wrapper"
         id="mainWrapper">


        <main class="main-content">

            @RenderBody()

        </main>


    </div>



    <!-- =====================================================
         FOOTER
    ===================================================== -->

    <footer class="admin-footer">

        <span>

            © @DateTime.Now.Year

            <strong>
                RepairHub
            </strong>

        </span>


        <span>

            Admin Management System

        </span>

    </footer>



    <!-- =====================================================
         JAVASCRIPT
    ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        const menuButton =
            document.getElementById("menuButton");

        const sidebar =
            document.getElementById("sidebar");

        const mainWrapper =
            document.getElementById("mainWrapper");


        /* ==========================================
           OPEN / CLOSE SIDEBAR
        ========================================== */

        menuButton.addEventListener("click", function () {

            if (window.innerWidth <= 991) {

                sidebar.classList.toggle("mobile-open");

            }
            else {

                sidebar.classList.toggle("closed");

                mainWrapper.classList.toggle("expanded");

            }

        });


        /* ==========================================
           CLOSE SIDEBAR ON MOBILE
        ========================================== */

        document.addEventListener("click", function (event) {

            if (window.innerWidth <= 991) {

                if (
                    sidebar.classList.contains("mobile-open") &&
                    !sidebar.contains(event.target) &&
                    !menuButton.contains(event.target)
                ) {

                    sidebar.classList.remove("mobile-open");

                }

            }

        });


        /* ==========================================
           ACTIVE SIDEBAR LINK
        ========================================== */

        const currentPath =
            window.location.pathname.toLowerCase();


        document
            .querySelectorAll(".sidebar a")
            .forEach(function (link) {

                const href =
                    link.getAttribute("href");

                if (!href)
                    return;


                const linkPath =
                    new URL(
                        href,
                        window.location.origin
                    ).pathname.toLowerCase();


                if (
                    currentPath === linkPath ||
                    currentPath.startsWith(linkPath + "/")
                ) {

                    link.classList.add("active");

                }

            });

    </script>


    @await RenderSectionAsync(
                "Scripts",
                required: false
            )

</body>

</html>