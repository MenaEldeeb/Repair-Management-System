<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - RepairHub
    </title>

    <!-- Bootstrap -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Site CSS -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>


<body>

    <!-- =========================
         TOP NAVBAR
    ========================== -->

    <header>

        <nav class="top-navbar">

            <div class="container-fluid d-flex align-items-center justify-content-between">

                <!-- Left -->

                <div class="d-flex align-items-center">

                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button">

                        <i class="bi bi-list"></i>

                    </button>


                    <a class="top-brand"
                       asp-controller="Home"
                       asp-action="Index">

                        <span class="top-brand-icon">

                            <i class="bi bi-tools"></i>

                        </span>

                        <span>

                            Repair<span class="brand-blue">Hub</span>

                        </span>

                    </a>

                </div>


                <!-- Right -->

                <div class="top-navbar-right">

                    <span class="system-online">

                        <i class="bi bi-circle-fill"></i>

                        System Online

                    </span>

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar"
           id="sidebar">

        <div class="sidebar-menu">

            <a class="sidebar-link"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-grid-1x2"></i>

                <span>Dashboard</span>

            </a>


            <div class="sidebar-label">

                MANAGEMENT

            </div>


            <a class="sidebar-link"
               asp-controller="Customers"
               asp-action="Index">

                <i class="bi bi-people"></i>

                <span>Customers</span>

            </a>


            <a class="sidebar-link"
               asp-controller="Devices"
               asp-action="Index">

                <i class="bi bi-laptop"></i>

                <span>Devices</span>

            </a>


            <a class="sidebar-link"
               asp-controller="Technicians"
               asp-action="Index">

                <i class="bi bi-person-gear"></i>

                <span>Technicians</span>

            </a>


            <a class="sidebar-link"
               asp-controller="RepairOrders"
               asp-action="Index">

                <i class="bi bi-tools"></i>

                <span>Repair Orders</span>

            </a>


            <a class="sidebar-link"
               asp-controller="Payments"
               asp-action="Index">

                <i class="bi bi-credit-card"></i>

                <span>Payments</span>

            </a>

        </div>


        <!-- Sidebar Bottom -->

        <div class="sidebar-bottom">

            <div class="sidebar-status">

                <span class="status-dot"></span>

                System Ready

            </div>

        </div>

    </aside>


    <!-- =========================
         MAIN WRAPPER
    ========================== -->

    <div class="page-wrapper">

        <!-- PAGE CONTENT -->

        <main class="main-content">

            @RenderBody()

        </main>


        <!-- =========================
             FOOTER
        ========================== -->

        <footer class="main-footer">

            <div class="container-fluid">

                <div class="footer-bottom">

                    <div>

                        © @DateTime.Now.Year
                        RepairHub. All rights reserved.

                    </div>

                    <div class="footer-made">

                        Repair Management System

                    </div>

                </div>

            </div>

        </footer>

    </div>


    <!-- =========================
         SCRIPTS
    ========================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <script>
    const sidebarToggle = document.getElementById("sidebarToggle");
    const sidebar = document.getElementById("sidebar");
    const pageWrapper = document.querySelector(".page-wrapper");

    sidebarToggle.addEventListener("click", function () {

        if (window.innerWidth <= 991) {
            // Mobile
            sidebar.classList.toggle("sidebar-mobile-show");
        }
        else {
            // Desktop
            sidebar.classList.toggle("sidebar-hidden");
            pageWrapper.classList.toggle("page-expanded");
        }

    });
</script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>